{
  "headline": "Boba at your dorm door, until 2am",
  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Golden Boba · late-night delivery for UCLA dorms</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Inter:wght@400;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{--ink:#241d17;--paper:#fff8e8;--tea:#7c3f2c;--pearl:#e0a63d;--mint:#2f6d5a}\n  *{box-sizing:border-box;margin:0}\n  body{font-family:Inter,system-ui,sans-serif;color:var(--ink);background:var(--paper);line-height:1.55}\n  h1,h2{font-family:Fraunces,Georgia,serif}\n  .wrap{max-width:900px;margin:0 auto;padding:24px}\n  header{background:linear-gradient(160deg,#7c3f2c,#4a2418);color:#fff8e8;padding:64px 24px;text-align:center}\n  header h1{font-size:clamp(30px,6vw,52px);max-width:18ch;margin:0 auto 12px}\n  header p{opacity:.9;max-width:46ch;margin:0 auto 24px}\n  .cta{display:inline-block;background:var(--pearl);color:#241d17;font-weight:600;text-decoration:none;padding:14px 28px;border-radius:999px}\n  .grid{display:grid;gap:16px;grid-template-columns:1fr}\n  @media (min-width:768px){.grid{grid-template-columns:repeat(3,1fr)}.wrap{padding:40px 24px}}\n  .card{background:#fff;border:1px solid #eaddc3;border-radius:14px;padding:18px}\n  .card h3{font-size:17px;margin-bottom:6px}\n  .dot{width:34px;height:34px;border-radius:50%;background:var(--mint);margin-bottom:10px}\n  ol.steps{padding-left:20px}\n  ol.steps li{margin:8px 0}\n  table.prices{width:100%;border-collapse:collapse;background:#fff;border:1px solid #eaddc3;border-radius:12px;overflow:hidden;font-size:15px}\n  table.prices th,table.prices td{padding:12px 14px;border-bottom:1px solid #f0e6cf;text-align:left}\n  table.prices tr:last-child td{border-bottom:0}\n  .pill{background:#f5ecd7;border-radius:999px;padding:3px 10px;font-size:13px}\n  details{background:#fff;border:1px solid #eaddc3;border-radius:12px;padding:12px 16px;margin:10px 0}\n  summary{cursor:pointer;font-weight:600}\n  form.signup{background:#fff;border:2px dashed var(--tea);border-radius:14px;padding:20px;margin-top:8px}\n  form.signup input{padding:12px;border:1px solid #d9cba8;border-radius:10px;min-width:60%;font-size:15px}\n  form.signup button{background:var(--tea);color:#fff;border:0;border-radius:10px;padding:12px 20px;font-size:15px;font-weight:600;cursor:pointer}\n  footer{padding:28px 24px;color:#6b6053;font-size:14px;text-align:center}\n  footer a{color:var(--tea)}\n</style>\n</head>\n<body>\n<header>\n  <h1>Boba at your dorm door, until 2am</h1>\n  <p>Golden Boba delivers real pearl teas to UCLA dorms in Westwood past the last campus counter close. Order one cup, no minimum, no detour.</p>\n  <a class=\"cta\" href=\"#signup\">Waitlist for launch night</a>\n</header>\n<main class=\"wrap\">\n  <section>\n    <h2>Why students pick us</h2>\n    <br>\n    <div class=\"grid\">\n      <div class=\"card\"><div class=\"dot\"></div><h3>Open past 23:00</h3><p>Every competitor closes by 23:00; our kitchen runs until 2am so the 1am study session gets pearls too.</p></div>\n      <div class=\"card\"><div class=\"dot\"></div><h3>Single-cup orders</h3><p>No $25 minimum like delivery apps. One 20oz brown-sugar milk tea, $6.50, dropped at your door.</p></div>\n      <div class=\"card\"><div class=\"dot\"></div><h3>Dorm-route timing</h3><p>Drivers batch by dorm floor, so your pickup lands inside a 15-minute window you pick at checkout.</p></div>\n    </div>\n  </section>\n  <section>\n    <h2>How it works</h2>\n    <ol class=\"steps\">\n      <li>Pick your tea and sweetness, choose a dorm and a 15-minute window.</li>\n      <li>We brew in batches every 30 minutes and sort by dorm route.</li>\n      <li>A courier walks your floor and texts when they are at the door.</li>\n    </ol>\n  </section>\n  <section>\n    <h2>Pricing</h2>\n    <table class=\"prices\">\n      <tr><th>Tier</th><th>What is inside</th><th>Price</th></tr>\n      <tr><td>Single</td><td>Any 20oz tea, one flavor, dorm dropoff</td><td>$6.50–$8.75</td></tr>\n      <tr><td>Duo pack</td><td>Two teas, same window, one dropoff</td><td>$11.50</td></tr>\n      <tr><td>Floor pass</td><td>5 teas shareable per night</td><td>$29</td></tr>\n    </table>\n    <p><small>Market band for Westwood boba is $6–9 per drink, matching our launch pricing.</small></p>\n  </section>\n  <section>\n    <h2>FAQ</h2>\n    <details><summary>How late do you actually deliver?</summary><p>Kitchen runs until 1:30am, last courier dispatch is 2:00am, both later than every competitor we checked.</p></details>\n    <details><summary>Do you deliver to hill dorms?</summary><p>We start with the Hill residential halls, then expand to Westwood apartments.</p></details>\n    <details><summary>Can I pay cash?</summary><p>Launch night is card or Venmo; cash support lands with the floor passes.</p></details>\n  </section>\n  <section>\n    <form class=\"signup\" id=\"signup\" action=\"mailto:founder@goldenboba.example\" method=\"post\" enctype=\"text/plain\">\n      <h2>Join the launch-night list</h2>\n      <p>We email you the night the 2am window opens.</p>\n      <input type=\"email\" name=\"email\" placeholder=\"you@ucla.edu\" required>\n      <button type=\"submit\">Keep me posted</button>\n    </form>\n  </section>\n</main>\n<footer>\n  Built by Headcount: 1 · <a href=\"__SITE_URL__\">see the run that built this page</a>\n</footer>\n</body>\n</html>\n"
}
