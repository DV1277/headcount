# Headcount: 1 - environment template.
# Copy to .env (or run `npm run keys`) and fill in. Never commit .env.
# Keys are server-side only: never ship them to the browser.

# ---------------------------------------------------------------- StepFun (the Mayor)
# Get it: https://platform.stepfun.ai -> API Keys
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/v1
STEPFUN_MODEL=step-5-preview

# ---------------------------------------------------------------- CREAO (Scout / Maker / Herald)
# Primary path: saved agents on agent.creao.ai, using app-scoped capi_ keys.
CREAO_API_MODE=app
CREAO_SCOUT_APP_ID=
CREAO_SCOUT_APP_KEY=
CREAO_MAKER_APP_ID=
CREAO_MAKER_APP_KEY=
CREAO_HERALD_APP_ID=
CREAO_HERALD_APP_KEY=
# Optional account path, used only with CREAO_API_MODE=account.
# Account key (prefix cr_sk_). Get it: https://developer.creao.ai -> API Keys
CREAO_API_KEY=
CREAO_BASE_URL=https://developer.creao.ai/v1
# Agent IDs. Get them: Developer Console -> Agents (https://developer.creao.ai)
CREAO_SCOUT_AGENT_ID=
CREAO_MAKER_AGENT_ID=
CREAO_HERALD_AGENT_ID=
# Optional: app-scoped path. Per-agent key (prefix capi_) from the agent's page on https://agent.creao.ai
CREAO_APP_KEY=
CREAO_APP_ID=

# ---------------------------------------------------------------- Browser Use (stretch: live browser view)
# Get it: https://cloud.browser-use.com -> API keys
BROWSER_USE_API_KEY=

# ---------------------------------------------------------------- Cognition Devin
# Service-user key (prefix cog_). Get it: https://app.devin.ai -> Settings -> Devin API
#   -> Service users -> Provision service user (role: Member)
DEVIN_API_KEY=
# Org ID: shown at the top of the same Settings -> Devin API page (https://app.devin.ai)
DEVIN_ORG_ID=

# ---------------------------------------------------------------- ElevenLabs (voices)
# Get it: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional default voice ID (https://elevenlabs.io/app/voice-library)
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------- No API key needed
# Paper: no API key. Paper is a desktop app that exposes an MCP server; install Paper Desktop.
# Workday: no API key. Challenge brief only, there is no API to integrate.

# ---------------------------------------------------------------- Headcount runtime (G-1/G0 scaffold)
HC_PORT=8787
HC_SITES_PORT=8788
HC_MODE=live
HC_MAYOR=stepfun
HC_WORKERS=creao
HC_MOCK_SPEED=1
HC_TASK_TIMEOUT_MS=360000
HC_MAX_CREAO_RUNS=8
HC_MAX_STEP_TOKENS=200000
HC_DEMO_RUN=golden-boba
HC_DEMO_SPEED=1
HC_KILL=0
HC_ASSERT_EVENTS=1
CREAO_CREDIT_USD=0.10
STEPFUN_USD_PER_M_IN=1.00
STEPFUN_USD_PER_M_OUT=2.70
STEPFUN_USD_PER_M_CACHED=0.10
# Optional public sites-only tunnel URL; never expose the control API.
PUBLIC_BASE_URL=
