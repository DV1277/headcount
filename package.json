{
  "name": "headcount-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "keys": "node scripts/setup-keys.mjs",
    "check": "node --env-file-if-exists=.env scripts/check-keys.mjs",
    "check:deep": "node --env-file-if-exists=.env scripts/check-keys.mjs --deep",
    "dev": "npm run dev --workspace @hc/web",
    "demo": "npm run dev --workspace @hc/web -- --port 5173 --strictPort --open '/?replay=fixture:live-boba-g2&speed=20'",
    "dev:server": "npm run dev --workspace @hc/server",
    "build": "npm run build --workspace @hc/web",
    "preview": "npm run preview --workspace @hc/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node --import tsx scripts/smoke.ts",
    "smoke:foundation": "node --import tsx scripts/smoke-foundation.ts",
    "record": "node --import tsx scripts/record.ts",
    "verify:real": "node --env-file-if-exists=.env --import tsx scripts/verify-real-run.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "build:edge": "VITE_PUBLIC_DEMO=1 npm run build && node scripts/prepare-edge.mjs",
    "dev:edge": "npm run build:edge && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --config wrangler.jsonc --port 8790",
    "deploy": "npm run build:edge && wrangler deploy --config wrangler.jsonc",
    "deploy:check": "npm run build:edge && wrangler deploy --config wrangler.jsonc --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.5.4",
    "vite": "~5.4.0",
    "vitest": "^2.1.0",
    "wrangler": "4.151.1"
  }
}
